        {
          "id": "928e14f7-91c8-4d13-9613-c49f14469711",
          "name": "Sign-in with API Key & API Secret",
          "request": {
            "name": "Sign-in with API Key & API Secret",
            "description": {
              "content": "With this endpoint you can obtain an Access Token, which is required to access secured endpoints. To do so, you have to provide both an API Key and an API Secret.\nThey can be generated on https://product.early.app or, if you have an Access Token already, with a POST request to /developer/api-access.\nIf you have an Access Token, you need to set the Authorization Header in every secured request to Bearer your_access_token.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v4",
                "developer",
                "sign-in"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{API_KEY}}\",\n  \"apiSecret\": \"{{API_SECRET}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "2f70481d-7c99-43a0-8393-f76d930f4a75",
