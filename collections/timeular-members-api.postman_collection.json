  "info": {
    "_postman_id": "cf9a84d4-ea2e-4d81-a152-85335e4c4811",
    "name": "EARLY (Timeular) Public Activities Members API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Public REST API for EARLY (formerly Timeular) time tracking. Manage activities, time entries, live tracking, tags & mentions, folders, users, leaves, and webhook subscriptions. Authentication is via API Key + API Secret exchanged for a Bearer Access Token. Derived by API Evangelist from the provider-published public Postman collection.\n\nContact Support:\n Name: EARLY Developer Support",
      "type": "text/plain"
    }
  }
