        {
          "id": "6d6453f9-2722-45f9-a49a-238755a17a91",
          "name": "Add Member to Folder",
          "request": {
            "name": "Add Member to Folder",
            "description": {
              "content": "With this endpoint you can add a new Member to an existing Folder. You should identify new Member by email and set their access level to \"full\" or \"personal\".\nTeam members with a subscription seat are immediately added to Folder.\nUsers without a subscription seat or without a EARLY account receive an invitation email and their \"id\" in response body has value \"pending\". They will appear with a Guest badge in the Members list.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v4",
                "folders",
                ":id",
                "members"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"my-teammate@example.com\",\n  \"accessLevel\": \"personal\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
