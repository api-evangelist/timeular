            "name": "Edit Tracking",
            "description": {
              "content": "With this endpoint you can set/edit/remove the note of your current Tracking.\nTo remove the note set it to null/empty/blank. You can provide one or more Tags and Mentions in a note, each of them prefixed with # or @. If the related activity is bound to some Integration, let’s say a JIRA Project, JIRA task IDs are valid Mentions too.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v4",
                "tracking"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
